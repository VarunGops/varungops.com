---
import { render } from 'astro:content';
import { section } from '../lib/content.js';
const { entry, hidden } = await section('life');
const { Content } = await render(entry);
---
<section class="stop" data-label="Life"><div>
  <p class="label">Life</p><h2>{entry.data.heading}</h2>
  {!hidden && <Content />}
</div></section>
