---
// The anatomy at the top of a section page. The heart keeps its own ids and classes (its tests and styles use them);
// the wider pieces draw on #art. The still shows until a frame is drawn, and stays when one cannot be.
interface Props { kind: 'heart' | 'eyes' | 'hands' | 'lungs' | 'neuron' | 'pair' | 'arcuate' }
const { kind } = Astro.props;
const BG = new Set(['heart', 'hands', 'lungs', 'neuron', 'pair', 'arcuate']);   // the pages with a background behind the anatomy (src/stage/bg/layer.js)
const ALT = {
  eyes: 'A pair of human eyes from the front, in colour, with fine strands of light fanning out from the pupils',
  hands: 'Two human hands cast from life, drawn in grey, one reaching down and one reaching up, joined by red strings',
  arcuate: 'The arcuate fasciculus, the brain’s language pathway, seen from the left inside a faint outline of the brain, light running along it',
  pair: 'Two real human brain cells, one amber and one cyan, a signal running from the first along its axon to the synapses it makes on the second',
  neuron: 'A single human pyramidal neuron from the cortex, its branches drawn as fine coloured lines, light running out from the cell body to the tips',
  lungs: 'A pair of human lungs from the front, drawn as a red engraving, breathing, the bronchi showing through',
};
---
{kind === 'heart' ? (
  <div class="art" data-art="heart">
    <canvas id="bg" class="bg-canvas" aria-hidden="true"></canvas>
    <div class="heart-wrap art-heart">
      <img class="still still-heart" src="/still/heart.webp" alt="An anatomical heart drawn as a red engraving" width="800" height="1000" decoding="async" />
      <canvas id="heart" class="heart" aria-hidden="true"></canvas>
    </div>
  </div>
) : (
  <div class="art art-wide" data-art={kind}>
    {BG.has(kind) && <canvas id="bg" class="bg-canvas" aria-hidden="true"></canvas>}
    <picture>
      <source media="(max-width: 699px)" srcset={`/still/${kind}-phone.webp`} />
      <img class="still still-art" src={`/still/${kind}.webp`} alt={ALT[kind]} width="1280" height="640" decoding="async" />
    </picture>
    <canvas id="art" class="art-canvas" aria-hidden="true"></canvas>
  </div>
)}
<script>
  import '../stage/side.js';
</script>
