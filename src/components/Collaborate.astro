---
import { render } from 'astro:content';
import { section } from '../lib/content.js';
const { entry, hidden } = await section('collaborate');
const { Content } = await render(entry);
---
<section class="stop" data-label="Collaborate"><div>
  <p class="label">Collaborate</p><h2>{entry.data.heading}</h2>
  {!hidden && <Content />}
</div></section>
