---
import { render } from 'astro:content';
import { ordered, span } from '../lib/content.js';
const posts = await Promise.all((await ordered('experience')).map(async e => ({ e, Content: (await render(e)).Content })));
---
<section class="stop" data-label="Clinical Experience"><div>
  <p class="label">Clinical Experience</p><h2>Wards, theatres and intensive care</h2>
  <ul class="items">
    {posts.map(({ e, Content }) => (
      <li class:list={{ brief: !e.data.described }}>
        <span class="when">{span(e.data.start, e.data.end)}</span><strong>{e.data.title}</strong><span class="where">{e.data.place}</span>
        {e.data.described && <Content />}
      </li>
    ))}
  </ul>
  <p class="small">MBBS, Adichunchanagiri Institute of Medical Sciences. Full GMC registration with a licence to practise, No. 7993092. ATLS, CCrISP, Good Clinical Practice and Neuroradiology Certification.</p>
</div></section>
