---
import { getCollection } from 'astro:content';
const posts = (await getCollection('writing', e => !e.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
---
<ul class="items">
  {posts.map(p => <li><span class="when">{p.data.date.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })}</span><strong><a class="entry" href={`/writing/${p.id}/`}>{p.data.title}</a></strong><p>{p.data.summary}</p></li>)}
</ul>
