---
import { render } from 'astro:content';
import { section, monthYear } from '../lib/content.js';
const { entry, hidden } = await section('now');
const { Content } = await render(entry);
---
<section class="stop" data-label="Now"><div>
  <p class="label">Now{entry.data.updated && ` · ${monthYear(entry.data.updated)}`}</p><h2>{entry.data.heading}</h2>
  {!hidden && <Content />}
</div></section>
